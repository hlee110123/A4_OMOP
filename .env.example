# A4 OMOP database connection
#
# Copy to .env and fill in your own values. .env is gitignored and must never
# be committed.

PGHOST=your-postgres-host
PGPORT=5432
PGUSER=your-username
PGPASSWORD=your-password

# Structure is cloned FROM this database, INTO PGTARGET_DB
PGSOURCE_DB=source_db
PGSOURCE_SCHEMAS=dbo,res
PGTARGET_DB=a4
PGLOAD_SCHEMA=dbo

# Maintenance database used only to issue CREATE DATABASE
PGMAINT_DB=postgres
